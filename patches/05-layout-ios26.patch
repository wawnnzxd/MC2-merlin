+/* ---- 5b. Row grid — the alignment rule ------------------------------------
+   Nearly every row on this page is <th>label</th><td>value</td>. For those we
+   drop the table layout algorithm and lay the row out as flex.
+
+   Why bother: with `table-layout:auto` the label column is sized by content, so
+   a row whose value cell carries wide floats squeezes its label to 236px while
+   its neighbours sit at 248px. That 12px stagger repeats down the page and is
+   exactly the "something's off" feeling you can't point at. One flex-basis
+   token fixes every row at once. `table-layout:fixed` can't do it — the
+   colspan'd card-header row would define the column grid instead.
+
+   The `:has(> th + td:last-child)` guard is load-bearing, not decoration. The
+   访问控制 tab builds its ACL lists from JS only once you open that tab, and
+   those are real multi-column tables (th th th th) that need their percentage
+   widths. Without the guard they were laid out as flex and blew 105px past the
+   window. The guard also degrades safely: a browser without :has() drops these
+   rules and simply falls back to the old table layout.
+
+   Measured after, on all 8 tabs: label width 232px everywhere, value column
+   starting on the identical x everywhere, and no horizontal overflow. */
+#app .FormTable > tbody > tr:has(> th + td:last-child),
+#app .FormTable_table > tbody > tr:has(> th + td:last-child),
+#app .FormTable > thead > tr:has(> td:only-child),
+#app .FormTable_table > thead > tr:has(> td:only-child) {
+	display: flex;
+	align-items: center;
+}
+#app .FormTable > tbody > tr:has(> th + td:last-child) > th,
+#app .FormTable_table > tbody > tr:has(> th + td:last-child) > th {
+	flex: 0 0 var(--mc-label-w);
+	width: var(--mc-label-w);
+	min-width: 0;
+	box-sizing: border-box;
+}
+#app .FormTable > tbody > tr:has(> th + td:last-child) > td,
+#app .FormTable_table > tbody > tr:has(> th + td:last-child) > td,
+#app .FormTable > thead > tr:has(> td:only-child) > td,
+#app .FormTable_table > thead > tr:has(> td:only-child) > td {
+	flex: 1 1 auto;
+	min-width: 0;
+	box-sizing: border-box;
+}
+/* a tall value cell (config box, log, list) shouldn't drag its label to the
+   vertical middle of a 380px box, half a screen from what it names */
+#app .FormTable > tbody > tr:has(textarea) > th,
+#app .FormTable > tbody > tr:has(td table) > th,
+#app .FormTable > tbody > tr:has(td ul) > th { align-self: flex-start; }
+/* narrow windows: stack label over value instead of crushing the value column */
+@media (max-width: 860px) {
+	#app .FormTable > tbody > tr:has(> th + td:last-child),
+	#app .FormTable_table > tbody > tr:has(> th + td:last-child) { flex-wrap: wrap; }
+	#app .FormTable > tbody > tr:has(> th + td:last-child) > th,
+	#app .FormTable_table > tbody > tr:has(> th + td:last-child) > th {
+		flex-basis: 100%;
+		width: auto;
+		padding-bottom: 0 !important;
+	}
